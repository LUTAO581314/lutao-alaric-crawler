# ===== MCP 服务配置 =====
PORT=3000
LOG_LEVEL=info

# ===== 全球航班 (OpenSky Network) =====
# OpenSky 支持匿名访问（有频率限制），注册后可获得更高配额
# 注册: https://opensky-network.org/users/sign_in
OPENSKY_USERNAME=
OPENSKY_PASSWORD=

# ===== 全球新闻资讯 (Google News RSS, 无需 key) =====
# 无需配置即可使用 news_top / news_search

# ===== 全球实时情报 (World Monitor) =====
# 获取 key: https://worldmonitor.app/pro
# 或直接在 MCP 客户端添加远程服务器 https://worldmonitor.app/mcp (OAuth/Key 认证)
WORLDMONITOR_API_KEY=
WORLDMONITOR_API_BASE=https://api.worldmonitor.app

# ===== 国内社交 (MediaCrawler) =====
# 设置 MediaCrawler 仓库所在目录（相对本仓库根目录或绝对路径）
MEDIACRAWLER_DIR=collect/domestic-social/MediaCrawler

# ===== 代理（抓国内平台用） =====
# 格式: http://user:pass@host:port 或 socks5://user:pass@host:port
PROXY_URL=

# ===== 存储（可选） =====
DATA_DIR=./data
